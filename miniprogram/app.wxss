/* 原图直接用于品牌标识，以视窗裁切留白；不重新绘制商标。 */
.logo-window{position:relative;width:260rpx;height:84rpx;overflow:hidden}.logo-window .official-logo{position:absolute;width:390rpx;height:390rpx;left:-65rpx;top:-153rpx}.logo-light{mix-blend-mode:screen}.logo-light .official-logo{filter:grayscale(1) invert(1);mix-blend-mode:screen}.profile-logo{width:180rpx;flex-shrink:0}.profile-logo .logo-window{transform:scale(.65);transform-origin:left center}.package-description{margin-top:16rpx;white-space:pre-line;line-height:1.9}
/* 白底原色标识在明暗页面均保持官方配色与清晰度。 */
.logo-light{mix-blend-mode:normal;background:#fff;border-radius:6rpx}.logo-light .official-logo{filter:none;mix-blend-mode:normal}
