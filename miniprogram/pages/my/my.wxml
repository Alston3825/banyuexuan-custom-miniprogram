<view class="app">
 <block wx:if="{{screen === 'index'}}">
  <view class="home-hero"><image class="hero-img" src="/assets/brand-0.jpg" mode="aspectFill"/><view class="hero-shade"/>
   <view class="brand-lockup"><view class="logo-window logo-light"><image class="official-logo" src="/assets/brand-logo-original.jpg" mode="scaleToFill"/></view><text class="brand-sub">BANYUEXUAN · 母婴健康管理</text></view>
   <view class="home-copy"><text class="eyebrow">A NEW CHAPTER OF LOVE</text><view class="home-title">你的新生，<text>值得温柔以待。</text></view><text class="home-desc">从孕期陪伴到产后照护\n为每一个家庭，定制专属的月子时光</text>
    <view class="hero-link" data-route="story" bindtap="go">品牌故事 · 价值交付，安心托付 <text>↗</text></view>
    <view class="button-row"><button class="btn outline" data-route="consult" bindtap="go">预约咨询</button><button class="btn primary" data-route="store" bindtap="go">立即定制 ↗</button></view>
   </view>
  </view>
  <view class="section"><view class="eyebrow">MADE FOR YOUR FAMILY</view><view class="section-title">每一份关爱，都刚刚好</view><view class="muted">六大服务板块，自由搭配，安心看见每一笔花费。</view><view class="module-grid"><view wx:for="{{groups}}" wx:key="id" class="module-tile" data-route="store" bindtap="go"><text class="tile-num">0{{index+1}}</text><text>{{item.name}}</text></view></view><view class="brand-note">伴月而生 · 以爱相伴</view></view>
 </block>
 <block wx:elif="{{screen === 'story'}}">
  <view class="page-hero"><image src="/assets/care-0.jpg" mode="aspectFill"/><view class="hero-shade"/><view class="hero-caption"><text class="eyebrow">OUR STORY</text><view class="serif">价值交付，安心托付</view></view></view>
  <view class="section story"><text class="eyebrow">BANYUEXUAN</text><view class="section-title">陪伴家庭的每一次新生</view><view class="story-text">从孕期陪伴、产后妈妈与新生儿照护出发，为新生家庭量身打造“优养1000天计划”。</view><view class="quote">我们不止服务一个家庭，<text>而是陪伴家庭的每一次新生。</text></view><view class="section-title">让专业，成为温柔的底气</view><view class="story-text">妈妈护理、宝宝照护、科学膳食、产后修护、母婴空间与到府陪伴，围绕家庭的真实需求，组合成属于你的安心方案。</view><view class="card"><view class="eyebrow">OUR VISION</view><view class="story-text">成为客户值得托付的全周期母婴健康管理平台。</view></view><button class="btn primary" data-route="store" bindtap="go">开启我的定制之旅 ↗</button></view>
 </block>
 <block wx:elif="{{screen === 'store'}}">
  <view class="page-hero"><image src="{{store.imageUrl}}" mode="aspectFill"/><view class="hero-shade"/><view class="hero-caption"><text class="eyebrow">FIND YOUR SANCTUARY</text><view class="serif">选一处安心，住一段好时光</view><text class="muted">{{brand.name}} · 门店选择</text></view></view>
  <view class="section"><view class="section-heading"><text>选择服务门店</text><text class="tag">{{stores.length}}家门店</text></view><view wx:for="{{stores}}" wx:key="id" class="card store-card {{draft.storeId===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="storeSelect"><view class="section-heading"><text class="card-title">{{item.name}}</text><text class="radio">{{draft.storeId===item.id?'✓':'○'}}</text></view><view class="mint small">{{item.tag}}</view><view class="muted small">{{item.address}}</view><view wx:if="{{item.phone}}" class="muted small">联系电话：{{item.phone}}</view><view class="muted small">{{item.description}}</view></view><view class="notice">门店详细地址、可订房型与到访路线请向顾问确认。</view></view><view class="fixed-actions"><button class="btn primary" data-route="mode" bindtap="go">开始配置 · {{store.name}} →</button></view>
 </block>
 <block wx:elif="{{screen === 'mode'}}">
  <view class="section"><view class="store-line">{{store.name}} <text data-route="store" bindtap="go">切换 ↗</text></view><view class="eyebrow">YOUR CHOICE, YOUR WAY</view><view class="page-title">你的月子，<text>由你定义。</text></view><view class="muted">一键选好，或从心搭配。</view>
   <view class="mode-card"><image src="/assets/baby-0.jpg" mode="aspectFill"/><view class="mode-body"><text class="tag">01 / EASY CHOICE</text><view class="section-title">热门方案</view><view class="muted">六种不同侧重的推荐搭配，省去逐项挑选。选好后，仍可按你的需求微调。</view><button class="btn primary" data-route="presets" bindtap="go">选热门套餐 ↗</button></view></view>
   <view class="mode-card"><image src="/assets/care-0.jpg" mode="aspectFill"/><view class="mode-body"><text class="tag">02 / MADE FOR YOU</text><view class="section-title">定制我的月子</view><view class="muted">六大服务板块，自由组合。每一份需要都被照顾，每一笔花费清晰可见。</view><button class="btn outline" bindtap="startCustom">开始专属定制 ↗</button></view></view>
  </view>
 </block>
 <block wx:elif="{{screen === 'presets'}}">
  <view class="section"><view class="store-line">{{store.name}}<text>精选 {{presets.length}} 款</text></view><text class="eyebrow">THOUGHTFULLY CURATED</text><view class="page-title">总有一份，<text>懂你的需要。</text></view><view class="muted">从推荐开始，搭配属于自己的月子生活。</view>
   <view wx:for="{{presets}}" wx:key="id" class="package-card"><image class="package-image" src="{{item.imageUrl}}" mode="aspectFill"/><view class="package-body"><text class="tag">{{item.tag}} · {{item.days}}天</text><view class="card-title">{{item.name}}</view><view class="muted small">{{item.subtitle}}</view><view wx:if="{{item.description}}" class="muted small package-description">{{item.description}}</view><view class="package-footer"><view><text class="price">¥{{item.priceText}}</text><text class="muted small"> / 套</text></view><button class="btn primary compact" data-id="{{item.id}}" bindtap="selectPreset">查看方案 ↗</button></view></view></view>
   <view class="notice">套餐搭配与价格由门店维护，支持按需微调，实际档期和服务内容以门店确认为准。</view>
  </view>
 </block>
 <block wx:elif="{{screen === 'customizer'}}">
  <view class="config-hero"><image src="{{group.imageUrl}}" mode="aspectFill"/><view class="hero-shade"/><view class="config-caption"><text class="eyebrow">{{group.en}}</text><view class="serif">伴月轩 · {{group.name}}</view><view class="muted small">{{group.title}}</view></view></view>
  <scroll-view scroll-x class="step-tabs"><view class="tabs-inner"><view wx:for="{{groups}}" wx:key="id" class="step-tab {{step===index?'active':''}}" data-step="{{index}}" bindtap="setStep"><text>{{item.name}}</text><text class="step-dot"/></view></view></scroll-view>
  <view class="section config-section"><view class="store-line">{{store.name}}<text>{{step+1}} / 6</text></view><view class="day-line"><text>入住天数</text><view class="day-options"><text wx:for="{{[21,28,42,56]}}" wx:key="*this" data-value="{{item}}" bindtap="days" class="chip {{draft.days===item?'chosen':''}}">{{item}}天</text></view></view><view class="muted small">{{group.subtitle}}</view>
   <view wx:if="{{step===5}}" class="card"><view class="section-heading"><text class="card-title">到府服务天数</text><view class="stepper"><text data-delta="-1" bindtap="homeAdjust">−</text><input type="number" value="{{draft.homeDays}}" bindblur="homeInput"/><text data-delta="1" bindtap="homeAdjust">＋</text></view></view><view class="muted small">0天表示暂不选择到府服务，最多60天。</view></view>
   <view wx:for="{{fields}}" wx:key="id" wx:for-item="field" class="service-card"><view class="section-heading"><text class="card-title">{{field.title}}</text><text class="info-button" data-id="{{field.id}}" bindtap="detail">详情 ↗</text></view><image wx:if="{{field.image}}" class="service-image" src="{{field.imageUrl}}" mode="aspectFill"/><view class="muted small service-description">{{field.description}}</view><view class="option-list"><view wx:for="{{field.options}}" wx:key="label" wx:for-item="option" class="option {{option.selected?'selected':''}}" data-key="{{field.id}}" data-value="{{option.value}}" bindtap="select"><view><text>{{option.label}}</text><view class="option-price">{{option.price===0?'¥0':'¥'+option.priceText}}<text class="muted tiny"> / {{field.daily?'天':'项'}}</text></view></view><text class="radio">{{option.selected?'✓':'○'}}</text></view></view><view wx:if="{{field.id==='room'}}" class="info-button room-link" bindtap="roomDetail">查看空间说明与入住物品清单 →</view></view>
   <view wx:if="{{step===2}}" class="benefit-card"><text class="eyebrow">A LITTLE EXTRA CARE</text><view class="card-title">入住满28天，享15%修护积分</view><view class="muted small">当前预计 {{pointsText}} 积分，按方案金额计算。适用项目与兑换规则由门店确认，积分不作现金抵扣。</view></view>
  </view>
  <view class="price-bar"><view bindtap="toggleBill"><text class="tiny muted">预计方案金额 ⌃</text><view><text class="price">¥{{totalText}}</text></view></view><button class="btn primary" bindtap="next">{{step===5?'查看完整方案':'下一步 · '+groups[step+1].name}} →</button></view>
 </block>
 <block wx:elif="{{screen === 'preview'}}">
  <view class="config-hero"><image src="/assets/hero-0.jpg" mode="aspectFill"/><view class="hero-shade"/><view class="config-caption"><text class="eyebrow">MADE WITH LOVE, JUST FOR YOU</text><view class="serif">我的月子方案</view><view class="muted small">{{store.name}} · 入住{{draft.days}}天</view></view></view>
  <view class="section"><view class="summary-intro"><view class="muted tiny">门店价目版本 v{{catalogRevision}} · 按当前发布价格计算</view><text class="tag">{{summary.presetName}}</text><view class="summary-price"><text class="tiny">¥</text>{{totalText}}<text class="tiny muted"> / 预计总价</text></view><view class="muted small">逐项原标价合计 ¥{{originalText}} · 预计省 ¥{{savingsText}}</view></view>
   <view wx:for="{{summaryGroups}}" wx:key="name" wx:for-item="g" wx:for-index="gi" class="summary-group"><view class="section-heading"><text class="card-title">{{g.name}}</text><text class="info-button" data-step="{{gi}}" bindtap="edit">微调 ↗</text></view><view wx:if="{{!g.lines.length}}" class="muted small">暂未选择此类服务</view><view wx:for="{{g.lines}}" wx:key="id" class="bill-line"><view><text>{{item.title}}</text><view class="muted tiny">{{item.label}} · {{item.count}}{{item.unit}}</view></view><text class="bill-price">{{item.total===0?'已包含':'¥'+item.totalText}}</text></view></view>
   <view wx:if="{{draft.presetId}}" class="card"><view class="section-heading"><text>套餐价格调整</text><text class="mint">¥{{summary.adjustment}}</text></view><view class="muted tiny">套餐按门店设定价格计算；此项为套餐价与项目合计的差额。微调按项目差额结算。</view></view>
   <view class="benefit-card"><text class="eyebrow">YOUR EXCLUSIVE BENEFITS</text><view class="card-title">为你的新生，多一份心意</view><view wx:for="{{includedBenefits}}" wx:key="*this" class="benefit-line">✓ {{item}}</view><view wx:if="{{summary.giftEligible}}" class="benefit-line">✓ 满21天 · 伴月轩“一盒好孕”待产礼盒</view><view wx:if="{{summary.points}}" class="benefit-line">✓ 预计{{pointsText}}产后修护积分</view><view class="muted tiny">礼盒与积分规则以门店确认为准。第三方商场和联名品牌权益未核实，暂不列入承诺权益。</view></view>
   <view class="notice">本页为预算配置方案，不构成订单或医疗建议。服务项目按妈妈及宝宝实际情况评估，具体报价、房态、档期与内容以门店确认为准。</view>
  </view><view class="price-bar"><button class="btn outline" bindtap="saveWish">♡ 保存心愿单</button><button class="btn primary" data-route="consult" bindtap="go">预约咨询 ↗</button></view>
 </block>
 <block wx:elif="{{screen === 'room'}}">
  <view class="page-hero"><image src="/assets/nursery-0.jpg" mode="aspectFill"/><view class="hero-shade"/><view class="hero-caption"><text class="eyebrow">A PLACE TO FEEL AT HOME</text><view class="serif">静享月子时光</view></view></view><view class="section"><view class="notice">图片为伴月轩环境展示，非所选房型的独立实拍；真实房型图待门店补充。</view><view class="section-title">母婴空间 · 入住清单</view><view class="muted">从日常洗护到母婴用品，把琐碎交给我们，把时间留给自己。</view><view wx:for="{{inclusions}}" wx:key="*this" class="inclusion"><text class="mint">0{{index+1}}</text><text>{{item}}</text></view><view class="notice">设备型号、用品品牌、数量与房间布局以入住门店提供的确认清单为准。</view><button class="btn primary" bindtap="back">返回继续配置</button></view>
 </block>
 <block wx:elif="{{screen === 'my'}}">
  <view class="section"><view class="profile"><view class="profile-logo"><view class="logo-window logo-light"><image class="official-logo" src="/assets/brand-logo-original.jpg" mode="scaleToFill"/></view></view><view><text class="eyebrow">MY BANYUEXUAN</text><view class="section-title">我的伴月轩</view><view class="muted small">收藏一份心愿，期待一场新生。</view></view></view><view class="stats"><view><text>{{wishes.length}}</text><text class="muted small">心愿方案</text></view><view><text>{{consultations.length}}</text><text class="muted small">本机预约意向</text></view></view><view class="section-heading"><text class="card-title">我的心愿单</text><text class="muted small">仅本机可见</text></view>
   <view wx:if="{{!wishes.length}}" class="empty"><text class="empty-icon">♡</text><view>把心动的方案，留在这里</view><view class="muted small">完成配置后，点击“保存心愿单”。</view><button class="btn primary" data-route="store" bindtap="go">去定制我的月子 ↗</button></view>
   <view wx:for="{{wishes}}" wx:key="id" class="card wish"><view class="section-heading"><text class="tag">{{item.store}} · {{item.draft.days}}天</text><text class="muted tiny" data-id="{{item.id}}" bindtap="deleteWish">删除</text></view><view class="card-title" data-id="{{item.id}}" bindtap="loadWish">{{item.name}}</view><view class="package-footer"><text class="price">¥{{item.total}}</text><text class="info-button" data-id="{{item.id}}" bindtap="loadWish">查看方案 →</text></view><text class="muted tiny">保存于 {{item.created}}</text></view>
   <view class="section-heading"><text class="card-title">本机预约意向</text><text class="tag">未发送门店</text></view><view wx:if="{{!consultations.length}}" class="muted small pad">暂无预约意向。</view><view wx:for="{{consultations}}" wx:key="id" class="card"><view class="section-heading"><text>{{item.name}}</text><text class="mint small">本机保存</text></view><view class="muted small">{{item.store}} · {{item.date||'到访日期待定'}} · ¥{{item.total}}</view><view class="muted small">{{item.phone}}</view></view><view class="menu-row" bindtap="privacyInfo">隐私与数据说明 <text>↗</text></view><view class="menu-row" bindtap="clearData">清空本机数据 <text>→</text></view><view class="brand-note">伴月而生 · 以爱相伴</view>
  </view>
 </block>
 <block wx:elif="{{screen === 'consult'}}">
  <view class="section"><text class="eyebrow">LET’S MEET</text><view class="page-title">聊聊你的期待，<text>让我们为你安排。</text></view><view class="muted">{{store.name}} · 当前方案预算 ¥{{totalText}}</view><view class="notice">当前为本机预约意向记录，尚未连接门店后台。提交后不会自动通知门店，请到店出示方案。</view><view class="form-card"><text class="label">你的称呼 *</text><input class="input" placeholder="希望我们如何称呼你" maxlength="30" value="{{form.name}}" data-key="name" bindinput="formInput"/><text class="label">联系手机 *</text><input class="input" type="number" maxlength="11" placeholder="请输入11位手机号" value="{{form.phone}}" data-key="phone" bindinput="formInput"/><text class="label">期望到访日期</text><picker mode="date" value="{{form.date}}" data-key="date" bindchange="formInput"><view class="input">{{form.date||'选择日期（选填）'}}</view></picker><text class="label">想提前告诉我们的事</text><textarea class="input textarea" placeholder="例如预产期、房型偏好、需要了解的服务" maxlength="300" value="{{form.note}}" data-key="note" bindinput="formInput"/><view class="privacy-row"><text class="mint" bindtap="togglePrivacy">{{privacy?'☑':'□'}}</text><text bindtap="togglePrivacy">同意在本机保存以上信息，已阅读</text><text class="mint" bindtap="privacyInfo">隐私说明</text></view><button class="btn primary" bindtap="submitConsult">保存预约意向 ↗</button></view></view>
 </block>
 <block wx:elif="{{screen === 'service'}}"><view class="section" wx:if="{{detail}}"><view class="page-title">{{detail.title}}</view><image wx:if="{{detail.image}}" class="service-image" src="{{detail.imageUrl}}" mode="aspectFill"/><view class="story-text">{{detail.description}}</view></view></block>
 <view wx:if="{{modalVisible}}" class="overlay" bindtap="closeDetail"><view class="modal" catchtap="noop"><view class="section-heading"><text class="card-title">{{detail.title}}</text><text bindtap="closeDetail">✕</text></view><image wx:if="{{detail.image}}" class="service-image" src="{{detail.imageUrl}}" mode="aspectFill"/><view class="story-text">{{detail.description}}</view><view class="notice">服务按实际情况及专业评估安排，以门店确认内容为准。</view><button class="btn primary" bindtap="closeDetail">了解了</button></view></view>
 <view wx:if="{{showBill}}" class="overlay" bindtap="toggleBill"><view class="modal" catchtap="noop"><view class="section-heading"><text class="card-title">费用明细</text><text bindtap="toggleBill">✕</text></view><scroll-view scroll-y class="bill-scroll"><view wx:for="{{summary.lines}}" wx:key="id" class="bill-line"><text>{{item.title}}</text><text>¥{{item.total}}</text></view><view wx:if="{{draft.presetId}}" class="bill-line"><text>套餐价格调整</text><text>¥{{summary.adjustment}}</text></view></scroll-view><view class="section-heading"><text>预计总价</text><text class="price">¥{{totalText}}</text></view><view class="notice">预算供参考，实际以门店确认为准。</view></view></view>
</view>
